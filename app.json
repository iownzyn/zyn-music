{
  "name": "ZYN MUSIC",
  "description": "ZYN MUSIC Telegram voice-chat music bot, maintained by Zayn Malik and based on Saya Music with permission.",
  "repository": "https://github.com/iownzyn/zyn-music",
  "logo": "https://raw.githubusercontent.com/iownzyn/zyn-music/main/SayaMusic/assets/zyn-logo.svg",
  "keywords": [
    "python",
    "telegram",
    "music-bot",
    "pyrogram",
    "py-tgcalls",
    "render",
    "docker"
  ],
  "env": {
    "API_ID": {
      "description": "Telegram API ID from https://my.telegram.org.",
      "required": true,
      "value": ""
    },
    "API_HASH": {
      "description": "Telegram API hash from https://my.telegram.org.",
      "required": true,
      "value": ""
    },
    "BOT_TOKEN": {
      "description": "Bot token from BotFather.",
      "required": true,
      "value": ""
    },
    "OWNER_ID": {
      "description": "Telegram numeric user ID of the owner.",
      "required": false,
      "value": "9100108789"
    },
    "OWNER_USERNAME": {
      "description": "Telegram username of the owner (without @).",
      "required": false,
      "value": "shadowxtemp"
    },
    "BOT_USERNAME": {
      "description": "Bot username (without @).",
      "required": false,
      "value": "ZynMusicBot"
    },
    "LOGGER_ID": {
      "description": "Private log group or channel ID where the bot is admin.",
      "required": false,
      "value": "-1004420640566"
    },
    "STRING_SESSION": {
      "description": "Private Pyrogram/Kurigram assistant session string. Never commit or share it.",
      "required": true,
      "value": ""
    },
    "MONGO_DB_URI": {
      "description": "MongoDB connection string.",
      "required": true,
      "value": ""
    },
    "COOKIE_URL": {
      "description": "Raw URL to a Netscape-format YouTube cookies.txt file.",
      "required": false,
      "value": ""
    },
    "API_URL": {
      "description": "Optional external audio API base URL.",
      "required": false,
      "value": "https://pvtz.nexgenbots.xyz"
    },
    "VIDEO_API_URL": {
      "description": "Optional external video API base URL.",
      "required": false,
      "value": "https://api.video.nexgenbots.xyz"
    },
    "DEEP_API": {
      "description": "Optional Deep API key.",
      "required": false,
      "value": ""
    },
    "API_KEY": {
      "description": "Optional API key for external downloader API.",
      "required": false,
      "value": ""
    },
    "OWNER_NAME": {
      "description": "Owner display name.",
      "required": false,
      "value": "𝒁𝒂𝒚𝒏 𝑴𝒂𝒍𝒊𝒌"
    },
    "BOT_NAME": {
      "description": "Bot display name.",
      "required": false,
      "value": "𝐙𝐘𝐍 𝐌𝐔𝐒𝐈𝐂 🎧"
    },
    "SUPPORT_CHANNEL": {
      "description": "ZYN MUSIC support channel URL.",
      "required": false,
      "value": "https://t.me/zynmusicupdates"
    },
    "SUPPORT_CHAT": {
      "description": "ZYN MUSIC support chat URL.",
      "required": false,
      "value": "https://t.me/zynmusicupdates"
    }
  }
}
